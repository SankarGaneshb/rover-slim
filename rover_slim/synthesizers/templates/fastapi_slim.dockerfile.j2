# ==============================================================================
# STAGE 1: Ephemeral Build & Dependency Wheel Builder
# ==============================================================================
FROM {{ target_base_image }} AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt .
RUN pip install --no-cache-dir --user -r requirements-prod.txt

# ==============================================================================
# STAGE 2: Hardened Minimal FastAPI Runtime
# ==============================================================================
FROM {{ target_base_image }} AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -d /app -s /bin/false appuser

COPY --from=builder /root/.local /home/appuser/.local

ENV PATH="/home/appuser/.local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app:$PYTHONPATH"

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE {{ port | default(8080) }}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:{{ port | default(8080) }}/health || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "{{ port | default(8080) }}", "--workers", "1"]
