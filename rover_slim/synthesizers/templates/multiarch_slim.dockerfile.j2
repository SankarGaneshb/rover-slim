# ==============================================================================
# Multi-Architecture Production Dockerfile (linux/amd64, linux/arm64)
# Synthesized by Rover-Slim Container Optimization Engine
# ==============================================================================

# STAGE 1: Ephemeral Cross-Platform Wheel Builder
FROM --platform=$BUILDPLATFORM {{ target_base_image }} AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt .
RUN pip install --no-cache-dir --user -r requirements-prod.txt

# ==============================================================================
# STAGE 2: Hardened Minimal Production Runtime
# ==============================================================================
FROM {{ target_base_image }} AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -d /app -s /bin/false appuser

COPY --from=builder /root/.local /home/appuser/.local

ENV PATH="/home/appuser/.local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app:$PYTHONPATH"

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE {{ port | default(8080) }}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:{{ port | default(8080) }}/health || exit 1

{% if cmd %}
{% if cmd.strip().startswith('[') %}
CMD {{ cmd.strip() }}
{% else %}
CMD [{{ cmd.strip() }}]
{% endif %}
{% else %}
CMD ["python", "server.py"]
{% endif %}
